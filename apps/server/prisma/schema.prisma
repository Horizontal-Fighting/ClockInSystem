// 拼拼英语打卡 · 数据模型
//
// ★★ 多租户铁律（改动前必读，见 docs/02 文档 1.4.2）★★
//   1. 所有业务表必须带 tenantId；平台公共数据用 tenantId = 0
//   2. tenantId 由 ORM 层自动注入（见 src/common/tenant/prisma-tenant.extension.ts），业务代码禁止手写
//   3. 索引一律以 tenantId 打头
//   4. 唯一索引必须包含 tenantId，否则跨租户冲突
//
// ★ 主键说明：文档约定 bigint。Prisma 映射为 JS BigInt，
//   JSON 序列化会抛 "Do not know how to serialize a BigInt"，
//   已在 main.ts 用 BigInt.prototype.toJSON 全局兜底（转 Number）。
//   安全前提：ID 远小于 Number.MAX_SAFE_INTEGER(2^53)，本项目规模无风险。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 租户与账号
// ─────────────────────────────────────────────────────────────

/// 租户 = 培训机构。机构由平台人工开通，学生端靠扫码自助入班。
model Tenant {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(64)
  /// 机构码：全局唯一，用于扫码入班与后台识别
  code         String   @unique @db.VarChar(32)
  status       Int      @default(1) @db.TinyInt // 1正常 2停用
  contactName  String?  @db.VarChar(32)
  contactPhone String?  @db.VarChar(32)
  /// 学员配额（G1 套餐与配额）
  quotaStudent Int      @default(200)
  expireAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users      UserTenant[]
  configs    TenantConfig[]
  students   Student[]
  levels     Level[]
  groups     ClassGroup[]
  materials  Material[]

  @@map("tenant")
}

/// 微信身份 / 账号身份。一个 user 可属于多个 tenant（一个家长报多家机构）。
model User {
  id        BigInt   @id @default(autoincrement())
  /// 微信小程序 openid（仅取 openid，不采集手机号 —— 合规硬约束）
  openid    String?  @unique @db.VarChar(64)
  unionid   String?  @db.VarChar(64)
  /// 账号登录：用户名 + 密码哈希（不限制设备数）
  username  String?  @unique @db.VarChar(64)
  password  String?  @db.VarChar(128)
  nickname  String?  @db.VarChar(64)
  avatarUrl String?  @db.VarChar(255)
  status    Int      @default(1) @db.TinyInt // 1正常 2禁用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants UserTenant[]
  consents GuardianConsent[]

  @@index([status])
  @@map("user")
}

/// user 与 tenant 的多对多关联。★ 不要假设 user 与 tenant 是一对一。
model UserTenant {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  tenantId  BigInt
  /// 角色：1家长 2教师 3机构管理员 4平台管理员
  role      Int      @default(1) @db.TinyInt
  status    Int      @default(1) @db.TinyInt
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId, role])
  @@map("user_tenant")
}

/// 租户级配置覆盖（评分权重、星级阈值、录音保留策略等）。
/// key 相同的平台级配置用 tenantId = 0 表示。
model TenantConfig {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt
  key       String   @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_config")
}

// ─────────────────────────────────────────────────────────────
// 学员与合规
// ─────────────────────────────────────────────────────────────

/// 分级字典。★ 承载评分严格度配置（scoreCoeff / starThreshold），
/// 取代原「按学生年龄推导」方案 —— 因不采集生日。
model Level {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt
  code            String   @db.VarChar(16) // L1 ~ L9
  name            String   @db.VarChar(64)
  sort            Int      @default(0)
  /// SOE 苛刻指数 1.0~4.0，越大越严格
  scoreCoeff      Decimal  @default(1.0) @db.Decimal(3, 1)
  /// 星级阈值，如 {"3":85,"2":70,"1":0}
  starThreshold   Json?
  defaultEvalMode Int      @default(0) @db.TinyInt
  status          Int      @default(1) @db.TinyInt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  students  Student[]
  materials Material[]

  @@index([tenantId, sort])
  @@map("level")
}

/// 学员档案。★ 数据最小化：只有昵称 + 系统预置头像。
/// 已明确删除：真实姓名、生日、性别、年级、学校、位置、真人照片。
model Student {
  id           BigInt    @id @default(autoincrement())
  tenantId     BigInt
  nickname     String    @db.VarChar(32)
  /// 系统预置头像编号（如 cat_03）。不提供上传真人照片的入口。
  avatarPreset String?   @db.VarChar(16)
  levelId      BigInt?
  levelAssignedAt DateTime?
  parentUserId BigInt?
  /// 教师侧备注名（仅教师/后台可见），属教师工作记录
  teacherRemark String?  @db.VarChar(32)
  pinHash      String?   @db.VarChar(128)
  baseScore    Int?
  /// 1在读 2请假 3结业 4流失
  status       Int       @default(1) @db.TinyInt
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  level    Level?  @relation(fields: [levelId], references: [id])
  consents GuardianConsent[]

  @@index([tenantId, status])
  @@map("student")
}

/// 监护人知情同意记录。★ 合规强依赖，不可删除，作为举证凭证。
model GuardianConsent {
  id            BigInt    @id @default(autoincrement())
  tenantId      BigInt
  studentId     BigInt
  userId        BigInt
  policyVersion String    @db.VarChar(16)
  /// REGISTER / RECORDING / SHARE
  consentType   String    @db.VarChar(32)
  consented     Int       @db.TinyInt
  ip            String?   @db.VarChar(64)
  ua            String?   @db.VarChar(255)
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([tenantId, studentId])
  @@index([studentId, consentType])
  @@map("guardian_consent")
}

// ─────────────────────────────────────────────────────────────
// 班级与内容（M3 实现业务逻辑，M1 先建表以保证多租户底座可验证）
// ─────────────────────────────────────────────────────────────

model ClassGroup {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt
  name       String   @db.VarChar(64)
  /// 1班级 2小组
  type       Int      @default(1) @db.TinyInt
  parentId   BigInt?
  teacherId  BigInt?
  levelId    BigInt?
  inviteCode String?  @db.VarChar(32)
  status     Int      @default(1) @db.TinyInt
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("class_group")
}

model GroupMember {
  id        BigInt    @id @default(autoincrement())
  tenantId  BigInt
  groupId   BigInt
  studentId BigInt
  levelId   BigInt?
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  @@unique([groupId, studentId])
  @@index([tenantId, studentId])
  @@map("group_member")
}

/// 素材 = 被朗读、被评测的对象。
model Material {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt
  /// 1音素 2单词 3句子 4儿歌 5绘本段落
  type      Int      @db.TinyInt
  content   String   @db.VarChar(512)
  phonetic  String?  @db.VarChar(128)
  /// 音节划分，如 ["pen","cil"] —— 前端按音节拆分着色（PRD 2.3 / F2-4）
  syllables Json?
  /// 字母-音素映射，如 [{"l":"p","ph":"p"},{"l":"e","ph":"e"}] —— 自然拼读字母块
  letterPhonemeMap Json?
  translation String? @db.VarChar(255)
  audioNorm String?  @db.VarChar(255)
  audioSlow String?  @db.VarChar(255)
  audioMedium String? @db.VarChar(255)
  coverUrl  String?  @db.VarChar(255)
  levelId   BigInt?
  /// 0单词 1句子 2段落（冗余存储，避免运行时反查）
  evalMode  Int      @default(0) @db.TinyInt
  tags      Json?
  source    String?  @db.VarChar(64)
  copyrightNote String? @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  level  Level? @relation(fields: [levelId], references: [id])

  @@index([tenantId, type])
  @@map("material")
}

// ════════════════════════════════════════════════════════════════
// 以下为 M2–M6 业务表。所有业务表均带 tenantId（多租户铁律 1.4.2），
// 索引以 tenantId 打头，唯一索引含 tenantId。
// 引用既有表（tenant/student/material/level/user）统一用标量外键，
// 不挂 @relation，避免改动已应用迁移；租户隔离由 prisma-tenant.extension 保证。
// ════════════════════════════════════════════════════════════════

// ── M3 内容与任务 ────────────────────────────────────────────────

model MaterialPack {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt
  name      String   @db.VarChar(128)
  coverUrl  String?  @db.VarChar(255)
  levelId   BigInt?
  sort      Int      @default(0)
  status    Int      @default(1) @db.TinyInt // 1启用 2停用
  itemCount Int      @default(0)             // 冗余计数，列表展示用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PackItem[]

  @@index([tenantId, status])
  @@map("material_pack")
}

model PackItem {
  id        BigInt  @id @default(autoincrement())
  tenantId  BigInt
  packId    BigInt
  materialId BigInt
  sort      Int     @default(0)
  required  Int     @default(1) @db.TinyInt // 1必做 0选做
  createdAt DateTime @default(now())

  pack MaterialPack @relation(fields: [packId], references: [id])

  @@unique([packId, materialId])
  @@index([tenantId, packId])
  @@map("pack_item")
}

model Task {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt
  title          String   @db.VarChar(128)
  packId         BigInt?
  teacherId      BigInt?
  evalMode       Int      @default(0) @db.TinyInt // 0单词 1句子 2段落，冗余存储
  publishAt      DateTime?
  dueAt          DateTime?
  requireAll     Int      @default(0) @db.TinyInt
  allowMakeup    Int      @default(0) @db.TinyInt
  status         Int      @default(1) @db.TinyInt // 1草稿 2已发布 3已截止 4已归档
  targetType     Int?     @db.TinyInt // 1班级 2小组 3学生
  coursewareId   BigInt?
  requireCourseware Int    @default(0) @db.TinyInt
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  targets TaskTarget[]

  @@index([tenantId, status])
  @@map("task")
}

model TaskTarget {
  id        BigInt @id @default(autoincrement())
  tenantId  BigInt
  taskId    BigInt
  targetType Int  @db.TinyInt // 1班级 2小组 3学生
  targetId  BigInt

  task Task @relation(fields: [taskId], references: [id])

  @@unique([taskId, targetType, targetId])
  @@index([tenantId, targetType, targetId])
  @@map("task_target")
}

// ── M3 课件三表 ──────────────────────────────────────────────────

model Courseware {
  id                BigInt   @id @default(autoincrement())
  tenantId          BigInt
  title             String   @db.VarChar(128)
  coverUrl          String?  @db.VarChar(255)
  intro             String?  @db.VarChar(512)
  levelId           BigInt?
  blockCount        Int      @default(0)
  audioDurationTotal Int     @default(0)
  status            Int      @default(1) @db.TinyInt // 1草稿 2已发布 3已下架
  createdBy         BigInt?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  blocks CoursewareBlock[]

  @@index([tenantId, status])
  @@map("courseware")
}

model CoursewareBlock {
  id           BigInt   @id @default(autoincrement())
  tenantId     BigInt
  coursewareId BigInt
  blockType    Int      @db.TinyInt // 1文本 2图片 3讲解音频 4素材引用
  sort         Int      @default(0)
  textContent  String?  @db.Text
  assetUrl     String?  @db.VarChar(255) // 类型2/3：存 COS key，不存完整 URL
  durationMs   Int?
  refMaterialId BigInt?
  showTitle    String?  @db.VarChar(128)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courseware Courseware @relation(fields: [coursewareId], references: [id])

  @@index([coursewareId, sort])
  @@map("courseware_block")
}

model CoursewareProgress {
  id            BigInt   @id @default(autoincrement())
  tenantId      BigInt
  studentId     BigInt
  coursewareId  BigInt
  lastBlockSort Int      @default(0)
  finished      Int      @default(0) @db.TinyInt
  finishedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, coursewareId])
  @@index([tenantId, coursewareId])
  @@map("courseware_progress")
}

// ── M2 媒体 / 打卡 / 评测 ────────────────────────────────────────

model MediaFile {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt
  bucket     String?  @db.VarChar(64)
  objectKey  String   @db.VarChar(255) // COS key 或本地相对路径
  mime       String?  @db.VarChar(64)
  sizeBytes  Int?
  durationMs Int?
  createdAt  DateTime @default(now())

  checkinItems CheckinItem[]

  @@index([tenantId, id])
  @@map("media_file")
}

model CheckinRecord {
  id          BigInt    @id @default(autoincrement())
  tenantId    BigInt
  taskId      BigInt?
  studentId   BigInt
  dueDate     DateTime  @db.Date
  status      Int       @default(1) @db.TinyInt // 1待打卡 2已提交 3已点评 4需重做 5已完课
  itemTotal   Int       @default(0)
  itemDone    Int       @default(0)
  avgScore    Decimal?  @db.Decimal(5, 2)
  bestScore   Decimal?  @db.Decimal(5, 2)
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt

  items CheckinItem[]

  @@index([tenantId, studentId, dueDate])
  @@map("checkin_record")
}

model CheckinItem {
  id           BigInt    @id @default(autoincrement())
  tenantId     BigInt
  recordId     BigInt
  materialId   BigInt
  studentId    BigInt
  dueDate      DateTime  @db.Date
  audioFileId  BigInt?
  durationMs   Int?
  volumeAvg    Int?
  attemptCount Int       @default(1)
  score        Decimal?  @db.Decimal(5, 2)
  accuracy     Decimal?  @db.Decimal(5, 2)
  fluency      Decimal?  @db.Decimal(5, 2)
  completion   Decimal?  @db.Decimal(5, 2)
  star         Int?      @db.TinyInt // 1-3
  weakPhonemes Json?
  evalStatus   Int       @default(1) @db.TinyInt // 1待评测 2评测中 3成功 4失败
  evalProvider String?   @db.VarChar(32)
  evalCostMs   Int?
  isSelected   Int       @default(0) @db.TinyInt
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  record     CheckinRecord @relation(fields: [recordId], references: [id])
  audio      MediaFile?    @relation(fields: [audioFileId], references: [id])
  scoreDetail ScoreDetail?

  @@index([tenantId, recordId])
  @@index([tenantId, studentId, dueDate])
  @@map("checkin_item")
}

model ScoreDetail {
  id            BigInt   @id @default(autoincrement())
  tenantId      BigInt
  itemId        BigInt   @unique
  provider      String   @db.VarChar(32) // tencent_soe / iflytek
  rawJson       Json
  suggestedScore Decimal? @db.Decimal(5, 2)
  createdAt     DateTime @default(now())

  item CheckinItem @relation(fields: [itemId], references: [id])

  @@index([tenantId, itemId])
  @@map("score_detail")
}

model Review {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt
  recordId    BigInt
  itemId      BigInt?
  teacherId   BigInt?
  studentId   BigInt
  tagIds      Json?
  text        String?  @db.VarChar(500)
  audioFileId BigInt?
  needRedo    Int      @default(0) @db.TinyInt
  isRead      Int      @default(0) @db.TinyInt
  createdAt   DateTime @default(now())

  @@index([tenantId, recordId])
  @@index([tenantId, studentId])
  @@map("review")
}

// ── M5 统计与配置 ───────────────────────────────────────────────

model StudentStat {
  id              BigInt    @id @default(autoincrement())
  tenantId        BigInt
  studentId       BigInt    @unique
  continuousDays  Int       @default(0)
  maxContinuousDays Int     @default(0)
  totalDays       Int       @default(0)
  totalDurationMs Int       @default(0)
  totalStars      Int       @default(0)
  avgScore30d     Decimal?  @db.Decimal(5, 2)
  lastCheckinDate DateTime? @db.Date
  trend           Int       @default(2) @db.TinyInt // 1上升 2平稳 3下降
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, studentId])
  @@map("student_stat")
}

model DailyClassStat {
  id             BigInt    @id @default(autoincrement())
  tenantId       BigInt
  groupId        BigInt
  date           DateTime  @db.Date
  submittedCount Int       @default(0)
  reviewedCount  Int       @default(0)
  avgScore       Decimal?  @db.Decimal(5, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, groupId, date])
  @@map("daily_class_stat")
}

model SysConfig {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   // 0 表示全局默认
  configKey   String   @db.VarChar(64)
  configValue Json
  remark      String?  @db.VarChar(255)
  updatedBy   BigInt?
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, configKey])
  @@map("sys_config")
}

model MaterialPhoneme {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt   // 0 平台公共音素字典
  symbol          String   @db.VarChar(32)
  standardAudioUrl String? @db.VarChar(255)
  createdAt       DateTime @default(now())

  @@unique([tenantId, symbol])
  @@map("material_phoneme")
}

model TenantUsage {
  id            BigInt   @id @default(autoincrement())
  tenantId      BigInt
  date          DateTime  @db.Date
  evalCount     Int       @default(0)
  storageBytes  BigInt    @default(0)
  activeStudents Int      @default(0)
  activeTeachers Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, date])
  @@map("tenant_usage")
}

model Notification {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt
  userId     BigInt?
  templateId String?  @db.VarChar(64)
  status     Int      @default(0) @db.TinyInt // 0待发 1成功 2失败
  wxCode     String?  @db.VarChar(64)
  content    String?  @db.VarChar(512)
  createdAt  DateTime @default(now())

  @@index([tenantId, userId])
  @@map("notification")
}

model OperationLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt
  actorUserId BigInt?
  action      String   @db.VarChar(64)
  targetType  String?  @db.VarChar(32)
  targetId    BigInt?
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, action])
  @@map("operation_log")
}
