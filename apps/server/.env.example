# 复制为 apps/server/.env 后填写

# MySQL（docker/dev-compose.yml 里的默认账号）
DATABASE_URL="mysql://pinpin:pinpin_dev_pwd@localhost:3306/pinpin"

# Redis（M2 评测队列用，M1 先不接）
REDIS_URL="redis://localhost:6379"

# JWT：生产环境务必换成随机长字符串
JWT_SECRET="pinpin-dev-secret-change-me"
JWT_EXPIRES="30d"

PORT=3000

# 腾讯云（M2 评测接入时填，见 spike/.env 的三件套）
# TENCENTCLOUD_APPID=
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
